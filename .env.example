# Used only to seed the first Owner account in an empty database. Required in production.
DEVICEPASSPORT_ADMIN_EMAIL=owner@yourshop.lk
DEVICEPASSPORT_ADMIN_PASSWORD=replace-with-a-strong-password
# Signs app-owned staff sessions. Required in production.
DEVICEPASSPORT_SESSION_SECRET=replace-with-at-least-32-random-characters

# Public address used in QR codes and social previews after deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional paths. Docker config stores both under its persistent /app/.data volume.
# DEVICEPASSPORT_DATABASE_PATH=/absolute/persistent/path/device-passport.db
# DEVICEPASSPORT_BACKUP_PATH=/absolute/persistent/path/backups
